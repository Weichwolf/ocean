#!/bin/sh
set -eu

if [ "$1" != configure ]; then
    exit 0
fi
if ! getent passwd ocean-vm >/dev/null; then
    useradd --system --user-group --home-dir /nonexistent --shell /usr/sbin/nologin ocean-vm
fi

agent=ocean-agent
agent_home=/var/lib/ocean-agent
if ! getent passwd "$agent" >/dev/null; then
    useradd --system --user-group --add-subids-for-system --home-dir "$agent_home" --shell /usr/sbin/nologin "$agent"
fi
install -d -m 0700 -o "$agent" -g "$agent" "$agent_home"
runuser -u "$agent" -- mkdir -p "$agent_home/.config/systemd/user/default.target.wants"
runuser -u "$agent" -- ln -sfn /usr/lib/systemd/user/ocean-agent.service \
    "$agent_home/.config/systemd/user/default.target.wants/ocean-agent.service"

if [ -x /usr/sbin/policy-rc.d ] && ! /usr/sbin/policy-rc.d ocean-agent start; then
    exit 0
fi
if [ -d /run/systemd/system ] && [ "${OCEAN_AGENT_DEFER_START:-0}" != 1 ]; then
    loginctl enable-linger "$agent"
    uid=$(id -u "$agent")
    systemctl start "user@$uid.service"
    runuser -u "$agent" -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user daemon-reload
    runuser -u "$agent" -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user restart ocean-agent.service
    systemctl daemon-reload
    for service in ocean-storage-agent ocean-container-network ocean-network-agent ocean-https-agent ocean-wireguard-agent ocean-vm-agent; do
        if [ ! -x /usr/sbin/policy-rc.d ] || /usr/sbin/policy-rc.d "$service" restart; then
            systemctl try-restart "$service.service"
        fi
    done
fi
