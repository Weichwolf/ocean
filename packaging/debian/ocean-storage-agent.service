[Unit]
Description=ocean encrypted storage reconciler
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ocean-agent/storage.json

[Service]
ExecStart=/usr/bin/ocean-network-agent -mode storage
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=15s
Nice=10

[Install]
WantedBy=multi-user.target
