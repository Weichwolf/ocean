#!/bin/sh
set -eu

if [ "$1" = remove ] && getent passwd ocean-agent >/dev/null; then
    for unit in ocean-storage-agent.service ocean-smb-agent.service ocean-container-network.service ocean-network-agent.service ocean-https-agent.service ocean-wireguard-agent.service ocean-ipsec-agent.service ocean-vm-agent.service; do
        if [ -d /run/systemd/system ] && systemctl is-active --quiet "$unit"; then
            systemctl stop "$unit"
        fi
    done
    uid=$(id -u ocean-agent)
    if [ -S "/run/user/$uid/bus" ]; then
        runuser -u ocean-agent -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user stop ocean-agent.service
    fi
    runuser -u ocean-agent -- rm -f -- /var/lib/ocean-agent/.config/systemd/user/default.target.wants/ocean-agent.service
fi
