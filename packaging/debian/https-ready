#!/bin/sh
set -eu

/usr/sbin/nft get element inet ocean_https_gateway active_addresses "{ $1 }" >/dev/null
test -n "$(/usr/bin/ss -H -lnt 'sport = :443')"
shift

pids=
for backend in "$@"; do
    /usr/bin/curl --noproxy '*' --silent --max-time 1 --output /dev/null "http://$backend/" &
    pids="$pids $!"
done
ready=false
for pid in $pids; do
    if wait "$pid"; then
        ready=true
    fi
done
"$ready"
